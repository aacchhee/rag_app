# Copy to .env and fill in real values. .env is already gitignored.

# --- LLM API (Idun / OpenAI-compatible) ---
LLM_API_KEY=__REDACTED__
CHAT_URL=https://your-llm-endpoint/v1/chat/completions
CHAT_MODEL=your-default-chat-model
EMBEDDINGS_URL=https://your-llm-endpoint/v1/embeddings
EMBEDDINGS_MODEL=your-embeddings-model

# --- Qdrant ---
# Overridden to http://qdrant:6333 by docker-compose.yml for the rag service;
# kept here for reference / non-docker runs.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=course_notes
# QDRANT_API_KEY=

# --- Optional ---
# CHAT_ENABLE_THINKING=false
# CHAT_RETRY_WITH_THINKING_DISABLED=true
# DEBUG=false
